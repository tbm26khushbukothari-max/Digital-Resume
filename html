      text-align: center;
    }

    .footer-pill {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 18px 28px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.04);
      color: #d4d4d4;
    }

    .green-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #4ade80;
      animation: pulse 1.5s infinite;
    }

    @media (max-width: 980px) {
      .hero,
      .split-grid {
