<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Khushbu Kothari — Strategic brand, growth, and business professional building at the intersection of culture, technology, storytelling, and consumer experiences." />
  <meta name="keywords" content="Khushbu Kothari, Growth Strategy, Founder Office, Brand Strategy, GTM, Marketing, Resume, Portfolio" />
  <meta name="author" content="Khushbu Kothari" />

  <title>Khushbu Kothari | Futuristic Resume</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    :root {
      --bg: #050505;
      --card: rgba(255,255,255,0.05);
      --border: rgba(255,255,255,0.1);
      --text: #ffffff;
      --muted: #b4b4b4;
      --purple: #a855f7;
      --cyan: #22d3ee;
      --pink: #ec4899;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at top right, rgba(168,85,247,0.15), transparent 30%),
        radial-gradient(circle at bottom left, rgba(34,211,238,0.15), transparent 30%);
      z-index: -2;
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      z-index: -1;
      opacity: 0.4;
    }

    .container {
      width: min(1200px, 92%);
      margin: auto;
      padding: 60px 0 100px;
    }

    .glass {
      background: var(--card);
      border: 1px solid var(--border);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-radius: 32px;
      box-shadow: 0 0 40px rgba(168,85,247,0.08);
    }

    .hero {
      padding: 60px;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 50px;
      align-items: start;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-radius: 999px;
      border: 1px solid rgba(168,85,247,0.3);
      background: rgba(168,85,247,0.08);
      color: #d8b4fe;
      font-size: 12px;
      letter-spacing: 0.15em;
      margin-bottom: 30px;
      text-transform: uppercase;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--purple);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.4); }
      100% { opacity: 0.4; transform: scale(1); }
    }

    h1 {
      font-size: clamp(4rem, 10vw, 7rem);
      line-height: 0.9;
      font-weight: 900;
      letter-spacing: -0.06em;
    }

    .gradient {
      background: linear-gradient(90deg, var(--purple), var(--pink), var(--cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      margin-top: 30px;
      color: var(--muted);
      font-size: 1.15rem;
      line-height: 1.8;
      max-width: 700px;
    }

    .tags {
      margin-top: 40px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .tag {
      padding: 14px 20px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.03);
      color: #e4e4e4;
      transition: 0.3s ease;
      font-size: 0.95rem;
    }

    .tag:hover {
      transform: translateY(-3px);
      background: rgba(255,255,255,0.08);
      border-color: rgba(168,85,247,0.4);
    }

    .info-card {
      padding: 35px;
      background: rgba(0,0,0,0.35);
      border-radius: 28px;
      border: 1px solid var(--border);
    }

    .info-group {
      margin-bottom: 28px;
    }

    .info-label {
      color: #7a7a7a;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 11px;
      margin-bottom: 10px;
    }

    .info-value {
      color: white;
      line-height: 1.6;
      font-size: 1rem;
    }

    .section {
      margin-top: 120px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 50px;
    }

    .line {
      height: 1px;
      flex: 1;
      background: linear-gradient(to right, transparent, rgba(168,85,247,0.6), transparent);
    }

    h2 {
      font-size: 2.5rem;
      letter-spacing: -0.03em;
    }

    .experience-grid {
      display: grid;
      gap: 30px;
    }

    .experience-card {
      position: relative;
      overflow: hidden;
      padding: 40px;
      transition: 0.4s ease;
    }

    .experience-card:hover {
      transform: translateY(-6px);
      border-color: rgba(168,85,247,0.35);
    }

    .experience-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(168,85,247,0.08), transparent, rgba(34,211,238,0.08));
      opacity: 0;
      transition: 0.4s ease;
    }

    .experience-card:hover::before {
      opacity: 1;
    }

    .experience-top {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      position: relative;
      z-index: 1;
    }

    .company {
      color: #d8b4fe;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 12px;
      margin-bottom: 18px;
    }

    h3 {
      font-size: 2rem;
      margin-bottom: 25px;
      line-height: 1.2;
    }

    .points {
      display: grid;
      gap: 18px;
      color: var(--muted);
      line-height: 1.8;
    }

    .point {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    .bullet {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cyan);
      margin-top: 10px;
      flex-shrink: 0;
    }

    .period {
      color: #707070;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      white-space: nowrap;
      font-size: 12px;
    }

    .split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-top: 40px;
    }

    .split-card {
      padding: 40px;
    }

    .mini-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      margin-bottom: 24px;
      color: #c4b5fd;
    }

    .project {
