<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Khushbu Kothari | Strategy • Growth • Founder’s Office</title>

  <meta
    name="description"
    content="Khushbu Kothari — Strategic operator blending growth, storytelling, systems thinking, culture, and technology."
  />

  <meta
    name="keywords"
    content="Khushbu Kothari, Growth Strategy, Product Marketing, Founder Office, Brand Strategy, GTM, Google Resume"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>

    :root{
      --bg:#06070a;
      --card:rgba(255,255,255,0.05);
      --border:rgba(255,255,255,0.08);
      --text:#ffffff;
      --muted:#a1a1aa;
      --purple:#8b5cf6;
      --cyan:#22d3ee;
      --pink:#ec4899;
      --glass: blur(20px);
      --shadow: 0 20px 60px rgba(0,0,0,0.4);
      --radius: 28px;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      scroll-behavior:smooth;
    }

    body{
      background:var(--bg);
      color:var(--text);
      font-family:'Inter',sans-serif;
      overflow-x:hidden;
      position:relative;
    }

    body::before{
      content:'';
      position:fixed;
      inset:0;
      background:
      radial-gradient(circle at top right, rgba(139,92,246,0.15), transparent 25%),
      radial-gradient(circle at bottom left, rgba(34,211,238,0.12), transparent 30%);
      z-index:-2;
    }

    body::after{
      content:'';
      position:fixed;
      inset:0;
      background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size:40px 40px;
      opacity:0.4;
      z-index:-1;
    }

    .cursor-glow{
      width:400px;
      height:400px;
      background:radial-gradient(circle, rgba(139,92,246,0.15), transparent 70%);
      position:fixed;
      border-radius:50%;
      pointer-events:none;
      transform:translate(-50%, -50%);
      z-index:0;
      transition:0.08s linear;
    }

    .container{
      width:min(1200px,92%);
      margin:auto;
      position:relative;
      z-index:2;
    }

    section{
      padding:100px 0;
    }

    .glass{
      background:var(--card);
      backdrop-filter:var(--glass);
      -webkit-backdrop-filter:var(--glass);
      border:1px solid var(--border);
      box-shadow:var(--shadow);
      border-radius:var(--radius);
    }

    .hero{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.6fr 1fr;
      gap:40px;
      width:100%;
      padding:60px;
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:12px;
      padding:12px 20px;
      border-radius:999px;
      background:rgba(139,92,246,0.08);
      border:1px solid rgba(139,92,246,0.25);
      color:#d8b4fe;
      text-transform:uppercase;
      font-size:12px;
      letter-spacing:0.18em;
      margin-bottom:32px;
    }

    .pulse{
      width:8px;
      height:8px;
      background:var(--purple);
      border-radius:50%;
      animation:pulse 1.6s infinite;
    }

    @keyframes pulse{
      0%{transform:scale(1);opacity:0.4}
      50%{transform:scale(1.5);opacity:1}
      100%{transform:scale(1);opacity:0.4}
    }

    h1{
      font-size:clamp(4rem,9vw,7rem);
      line-height:0.9;
      font-weight:900;
      letter-spacing:-0.08em;
    }

    .gradient{
      background:linear-gradient(90deg,var(--purple),var(--pink),var(--cyan));
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
    }

    .hero-copy{
      margin-top:32px;
      max-width:720px;
      color:var(--muted);
      font-size:1.15rem;
      line-height:1.9;
    }

    .tags{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:40px;
    }

    .tag{
      padding:14px 20px;
      border-radius:18px;
      border:1px solid var(--border);
      background:rgba(255,255,255,0.03);
      color:#e4e4e7;
      transition:0.35s ease;
    }

    .tag:hover{
      transform:translateY(-4px);
      border-color:rgba(139,92,246,0.4);
      background:rgba(255,255,255,0.08);
    }

    .info-card{
      padding:36px;
      position:relative;
      overflow:hidden;
    }

    .info-block{
      margin-bottom:28px;
    }

    .label{
      color:#71717a;
      text-transform:uppercase;
      font-size:11px;
      letter-spacing:0.18em;
      margin-bottom:10px;
    }

    .value{
      color:#fafafa;
      line-height:1.7;
    }

    .section-title{
      display:flex;
      align-items:center;
      gap:24px;
      margin-bottom:60px;
    }

    .line{
      height:1px;
      flex:1;
      background:linear-gradient(to right, transparent, rgba(139,92,246,0.6), transparent);
    }

    h2{
      font-size:2.6rem;
      letter-spacing:-0.05em;
    }

    .summary-card{
      padding:50px;
    }

    .summary-card p{
      color:var(--muted);
      line-height:2;
      font-size:1.1rem;
      max-width:950px;
    }

    .timeline{
      display:grid;
      gap:28px;
    }

    .timeline-card{
      padding:40px;
      position:relative;
      overflow:hidden;
      transition:0.4s ease;
    }

    .timeline-card:hover{
      transform:translateY(-6px);
      border-color:rgba(139,92,246,0.35);
    }

    .timeline-top{
      display:flex;
      justify-content:space-between;
      gap:20px;
    }

    .company{
      color:#d8b4fe;
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:0.3em;
      margin-bottom:18px;
    }

    h3{
      font-size:2rem;
      margin-bottom:24px;
      line-height:1.2;
    }

    .points{
      display:grid;
      gap:18px;
      color:var(--muted);
      line-height:1.9;
    }

    .point{
      display:flex;
      gap:14px;
    }

    .bullet{
      width:8px;
      height:8px;
      border-radius:50%;
      background:var(--cyan);
      margin-top:11px;
      flex-shrink:0;
    }

    .period{
      color:#71717a;
      text-transform:uppercase;
      font-size:12px;
      letter-spacing:0.2em;
      white-space:nowrap;
    }

    .grid-2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:30px;
    }

    .card{
      padding:40px;
    }

    .mini{
      color:#c4b5fd;
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:0.3em;
      margin-bottom:24px;
    }

    .project{
      margin-bottom:34px;
    }

    .project h4{
      font-size:1.5rem;
      margin-bottom:12px;
    }

    .project p{
      color:var(--muted);
      line-height:1.9;
    }

    .skills{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:32px;
    }

    .skill{
      padding:14px 18px;
      border-radius:18px;
      background:rgba(255,255,255,0.03);
      border:1px solid var(--border);
      transition:0.3s ease;
    }

    .skill:hover{
      transform:translateY(-4px);
      border-color:rgba(34,211,238,0.4);
    }

    .roles{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
      margin-top:40px;
    }

    .role{
      padding:28px;
      text-align:center;
    }

    .role h4{
      margin-bottom:12px;
      font-size:1.3rem;
    }

    .role p{
      color:var(--muted);
      line-height:1.7;
    }

    footer{
      padding:80px 0;
      text-align:center;
    }

    .footer-pill{
      display:inline-flex;
      align-items:center;
      gap:14px;
      padding:18px 28px;
      border-radius:999px;
      border:1px solid var(--border);
      background:rgba(255,255,255,0.04);
      color:#d4d4d8;
    }

    .reveal{
      opacity:0;
      transform:translateY(40px);
      transition:all 1s cubic-bezier(.22,1,.36,1);
    }

    .reveal.active{
      opacity:1;
      transform:translateY(0);
    }

    @media(max-width:980px){

      .hero-grid,
      .grid-2,
      .roles{
        grid-template-columns:1fr;
      }

      .timeline-top{
        flex-direction:column;
      }

      h1{
        font-size:4.5rem;
      }

      section{
        padding:70px 0;
      }

    }

    @media(max-width:640px){

      .hero-grid,
      .card,
      .summary-card,
      .timeline-card{
        padding:28px;
      }

      h2{
        font-size:2rem;
      }

      h3{
        font-size:1.5rem;
      }

    }

  </style>
</head>

